{
  "name": "@ecom/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "check": "drizzle-kit check",
    "studio": "drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "seed:dev-catalog": "tsx --env-file-if-exists=../../.env src/seed-dev-catalog.ts",
    "bundle": "esbuild src/migrate.ts src/seed.ts --bundle --platform=node --target=node22 --format=esm --outdir=dist --out-extension:.js=.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@ecom/rbac": "workspace:*",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.0",
    "tsx": "^4.23.15"
  }
}
