# ---------------------------------------------------------------------------
# Copy to `.env` at the repo root for local development. Never commit `.env`.
# Both apps and the db scripts read this single root file.
# In production (Railway) set these as service variables instead.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database (PostgreSQL) -------------------------------------------------
# Local: docker/docker-compose.yml exposes Postgres on 5433.
# Railway: use the Postgres service's DATABASE_URL reference variable.
DATABASE_URL=postgres://ecom:ecom_dev_password@localhost:5433/ecom
# Used only by the automated test suite (created by docker/init-test-db.sql).
TEST_DATABASE_URL=postgres://ecom:ecom_dev_password@localhost:5433/ecom_test
# Max pooled connections per app instance.
DATABASE_POOL_MAX=10

# --- Redis (caching, BullMQ jobs) ------------------------------------------
REDIS_URL=redis://localhost:6380

# --- Authentication (Better Auth) ------------------------------------------
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public origins of each app (used for auth callbacks and trusted origins).
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --- Initial Super Admin (used once by `pnpm db:seed`) ---------------------
SEED_SUPERADMIN_EMAIL=owner@example.com
SEED_SUPERADMIN_PASSWORD=change-me-on-first-login
SEED_SUPERADMIN_NAME=Store Owner

# --- Branding ---------------------------------------------------------------
# Placeholder brand name until the real one is decided.
NEXT_PUBLIC_BRAND_NAME=Crimsonne
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# --- Email (Resend) ---------------------------------------------------------
# When empty, emails are written to the server log instead of being sent.
RESEND_API_KEY=
EMAIL_FROM="Store <no-reply@example.com>"

# --- Payments (Razorpay) — Phase 6 ------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Images (ImageKit) — Phase 4 --------------------------------------------
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Push (Firebase Cloud Messaging) — Phase 8 -------------------------------
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Maps (delivery navigation) — Phase 8 ------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
